generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}
model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  role         Role              @default(CANDIDATE)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  profile      CandidateProfile?
  sessions     AuthSession[]
  auditLogs    AuditLog[]
  resume       ResumeFile?
  createdJobs  JobOpening[]
}
model CandidateProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  name              String
  talentConsentAt   DateTime?
  phone             String?
  location          String?
  linkedIn          String?
  portfolio         String?
  seniority         Seniority?
  salaryCents       Int?
  summary           String?
  updatedAt         DateTime @updatedAt
  skills            CandidateSkill[]
  experiences       Experience[]
  education         Education[]
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
}
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}
enum RequirementKind {
  ESSENTIAL
  DESIRABLE
}
model Skill {
  id         String @id @default(uuid())
  name       String @unique
  candidates CandidateSkill[]
  requirements JobRequirement[]
}
model CandidateSkill {
  candidateId String
  skillId     String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill @relation(fields: [skillId], references: [id])
  @@id([candidateId, skillId])
  @@index([skillId])
}
model Experience {
  id          String @id @default(uuid())
  candidateId String
  company     String
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  description String?
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@index([candidateId])
}
model Education {
  id          String @id @default(uuid())
  candidateId String
  institution String
  course      String
  startsAt    DateTime
  endsAt      DateTime?
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@index([candidateId])
}
model ResumeFile {
  id          String @id @default(uuid())
  userId      String @unique
  storageKey  String @unique
  mimeType    String
  size        Int
  sha256      String
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Department {
  id    String @id @default(uuid())
  name  String @unique
  jobs  JobOpening[]
}
model JobOpening {
  id               String @id @default(uuid())
  title            String
  description      String
  departmentId     String
  seniority        Seniority
  workMode         String
  salaryMinCents   Int?
  salaryMaxCents   Int?
  opensAt          DateTime
  closesAt         DateTime
  status           JobStatus @default(DRAFT)
  technologyWeight Int @default(50)
  seniorityWeight  Int @default(30)
  salaryWeight     Int @default(20)
  criteriaVersion  Int @default(1)
  revision         Int @default(1)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        User @relation(fields: [createdById], references: [id])
  department       Department @relation(fields: [departmentId], references: [id])
  requirements     JobRequirement[]
  @@index([status, opensAt, closesAt])
  @@index([departmentId])
}
model JobRequirement {
  id        String @id @default(uuid())
  jobId     String
  skillId   String?
  text      String
  kind      RequirementKind
  job       JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill     Skill? @relation(fields: [skillId], references: [id])
  @@index([jobId])
  @@index([skillId])
}
model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  targetId  String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([createdAt])
}
