{
  "name": "pointmedia", "private": true, "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @pointmedia/api\" \"npm run dev -w @pointmedia/web\"",
    "env:setup": "node scripts/setup-env.cjs",
    "build:portable": "npm run typecheck && npm run build -w @pointmedia/api && node scripts/build-portable.mjs",
    "start:local": "node --env-file=.env scripts/serve-local.mjs",
    "test:local-ui": "node tests/local-ui-smoke.mjs",
    "test:phase2-ui": "node tests/phase2-ui-smoke.mjs",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "test": "node --test --test-isolation=none packages/shared/test/*.test.cjs tests/*.test.cjs && npm run test --workspaces --if-present",
    "test:policy": "node --test --test-isolation=none packages/shared/test/*.test.cjs",
    "test:database": "node --test --test-isolation=none tests/sqlite.test.cjs tests/migrations.test.cjs",
    "test:integration": "npm run test:integration -w @pointmedia/api",
    "test:e2e": "playwright test",
    "lint": "eslint apps packages scripts tests playwright.config.ts --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w @pointmedia/api",
    "db:migrate": "npm run db:migrate -w @pointmedia/api",
    "db:migrate:local": "node --env-file=.env scripts/migrate-local.cjs",
    "db:seed": "npm run db:seed -w @pointmedia/api"
  },
  "devDependencies": {"concurrently": "^9.2.0", "prettier": "^3.6.2", "eslint": "^9.34.0", "@eslint/js": "^9.34.0", "typescript-eslint": "^8.41.0", "globals": "^16.3.0", "@playwright/test": "^1.55.0", "typescript": "^5.9.2"}
}
